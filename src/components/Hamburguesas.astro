---
const hamburguesas = [
  {
    nombre: "FX",
    precio: "$32.000",
    descripcion:
      "Pan pretzel, 180g de carne de cerdo, doble queso mozzarella, cebolla caramelizada en frutos rojos, doble tocineta y mayonesa.",
    imagen: "images/FX.webp",
  },
  {
    nombre: "Caramelo",
    precio: "$32.000",
    descripcion:
      "Pan pretzel, 180g de carne de cerdo, queso philadelphia, trozos de patacón salado, doble tocineta y salsa de caramelo picante.",
    imagen: "images/CARAMELO.webp",
  },
  {
    nombre: "Smash Oklahoma",
    precio: "$32.000",
    descripcion:
      "Pan brioche, dos carnes angus tipo smash de 100g cada una, salsa smash, cebolla, queso cheddar, tocineta y pepinillos.",
    imagen: "images/smash-oklahoma.webp",
  },
  {
    nombre: "370",
    precio: "$32.000",
    descripcion:
      "Pan pretzel, 180g de carne, queso philadelphia, tocineta caramelizada y aros de cebolla.",
    imagen: "images/370.webp",
  },
];
---

<section
  id="hamburguesas"
  class="bg-[#111111] py-16 scroll-mt-56 md:scroll-mt-40"
>
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-10">
      <span
        class="text-orange-500 uppercase tracking-[0.3em] font-semibold text-sm"
      >
        Menú
      </span>

      <h2 class="mt-4 text-4xl md:text-6xl font-black text-white uppercase">
        Nuestras Hamburguesas
      </h2>

      <div class="w-24 h-1 bg-orange-500 mx-auto mt-6 rounded-full"></div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        hamburguesas.map((burger) => (
          <article
            class="
              bg-[#161616]
              rounded-3xl
              overflow-hidden
              border
              border-orange-500/20
              hover:border-orange-500
              transition-all
              duration-300
              flex
              flex-col
            "
          >
            <div class="overflow-hidden">
              <img
                src={burger.imagen}
                alt={burger.nombre}
                loading="lazy"
                decoding="async"
                class="
      w-full
      h-auto
      object-contain
    "
              />
            </div>

            <div class="p-6 flex flex-col flex-1">
              <h3
                class="
                  text-2xl
                  font-black
                  uppercase
                  text-orange-500
                "
              >
                {burger.nombre}
              </h3>

              <p
                class="
                  mt-3
                  text-gray-300
                  text-sm
                  leading-relaxed
                "
              >
                {burger.descripcion}
              </p>

              <div
                class="
                  mt-6
                  flex
                  justify-start
                  items-center
                "
              >
                <span
                  class="
                    text-3xl
                    font-black
                    text-white
                  "
                >
                  {burger.precio}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
